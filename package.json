{
  "name": "snowflake-promise",
  "version": "6.0.0",
  "description": "A Promise-based, TypeScript-friendly helper for the Snowflake SDK",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/natesilva/snowflake-promise.git"
  },
  "bugs": "https://github.com/natesilva/snowflake-promise/issues",
  "license": "MIT",
  "author": "Nate Silva <nate@natesilva.com>",
  "keywords": [
    "snowflake",
    "database",
    "data warehouse",
    "warehouse",
    "promise",
    "typescript"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "clean": "del-cli dist coverage",
    "build": "tsdown",
    "prepublishOnly": "npm run build",
    "format": "biome format --write",
    "lint": "tsc && biome check",
    "test": "node --experimental-test-module-mocks --test \"src/**/*.test.ts\"",
    "test:watch": "node --experimental-test-module-mocks --test --watch \"src/**/*.test.ts\"",
    "test:coverage": "node --experimental-test-module-mocks --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-exclude=\"**/__tests__/**\" --test \"src/**/*.test.ts\""
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@tsconfig/node-ts": "^23.6.1",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.5",
    "del-cli": "^8.0.1",
    "snowflake-sdk": "^3.4.1",
    "tsdown": "^0.23.5",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "snowflake-sdk": "^3.4.0"
  },
  "dependencies": {
    "type-fest": "^5.10.0"
  }
}
